# ─────────────────────────────────────────────────────────────
# Supabase
# Project Settings → API  (https://supabase.com/dashboard)
# ─────────────────────────────────────────────────────────────

# Safe to expose to the browser. Used by the storefront + admin login.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit.
# Bypasses Row Level Security — used to write guest orders and for admin mutations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Store configuration
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Heartland Hay Supply
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CURRENCY_LOCALE=en-US

# Flat delivery fee applied at checkout, in minor units (cents). 0 = free delivery.
DELIVERY_FEE_CENTS=4500
# Order subtotal (cents) above which delivery is free. Leave blank to always charge.
FREE_DELIVERY_THRESHOLD_CENTS=150000

# ─────────────────────────────────────────────────────────────
# Email — Resend (optional)
# https://resend.com → API Keys. Leave blank to disable email:
# orders and enquiries are still saved, nobody is just notified.
# ─────────────────────────────────────────────────────────────

RESEND_API_KEY=

# Must be an address on a domain you have verified in Resend.
# Format: Display Name <address@yourdomain.com>
EMAIL_FROM=Heartland Hay Supply <contact@heartandhaysupply.com>

# Where customer replies go.
EMAIL_REPLY_TO=contact@heartandhaysupply.com

# Inbox that new orders and enquiries are forwarded to.
# Comma-separate for several recipients.
STORE_NOTIFICATION_EMAIL=contact@heartandhaysupply.com
